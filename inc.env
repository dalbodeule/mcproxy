# mcproxy environment include file
# Usage (bash/zsh): set -a; source ./inc.env; set +a

# HTTP API bind address
MCPROXY_HTTP_ADDR=127.0.0.1:8080

# Minekube Gate bind address
MCPROXY_GATE_BIND=0.0.0.0:25565
MCPROXY_GATE_ONLINE_MODE=true
# Backend player information forwarding: none | legacy | velocity | bungeeguard
# Paper/Spigot legacy forwarding requires online-mode=false and bungeecord=true on the backend.
MCPROXY_GATE_FORWARDING_MODE=legacy
# Set the matching secret when using velocity or bungeeguard forwarding.
# MCPROXY_GATE_VELOCITY_SECRET=replace-with-the-backend-secret
# MCPROXY_GATE_BUNGEGUARD_SECRET=replace-with-the-backend-secret
MCPROXY_PING_CACHE_TTL_SEC=300
MCPROXY_PING_FALLBACK_MOTD="mcproxy online"
MCPROXY_PING_OFFLINE_MOTD="server unavailable"
# MCPROXY_PING_FALLBACK_FAVICON=data:image/png;base64,...

# Admin API token (required for /api/v1/*)
# MCPROXY_ADMIN_TOKEN=change-me
# Exact browser origins for a separately hosted SvelteKit admin panel (optional).
# MCPROXY_ADMIN_ALLOWED_ORIGINS=https://admin.example.com

# Database configuration
# Options: sqlite | postgres
MCPROXY_DB_DRIVER=sqlite
# SQLite file path (used when MCPROXY_DB_DRIVER=sqlite)
MCPROXY_SQLITE_PATH="data/mcproxy.db?_pragma=foreign_keys(1)"
# PostgreSQL DSN example (used when MCPROXY_DB_DRIVER=postgres)
# MCPROXY_POSTGRES_DSN=postgres://user:password@localhost:5432/mcproxy?sslmode=disable

# Redis for distributed counters/cache invalidation (optional)
# MCPROXY_REDIS_ADDR=127.0.0.1:6379
# MCPROXY_REDIS_CHANNEL=mcproxy:events

# GeoLite2-City.mmdb path (optional)
# MCPROXY_GEOIP_PATH=data/GeoLite2-City.mmdb

# Loki logging (optional)
# MCPROXY_LOKI_HOST=http://127.0.0.1:3100/loki/api/v1/push
MCPROXY_LOG_IDENTIFY=local
