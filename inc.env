# mcproxy environment include file
# Usage (bash/zsh): set -a; source ./inc.env; set +a

# HTTP API bind address
MCPROXY_HTTP_ADDR=127.0.0.1:8080

# Minekube Gate bind address
MCPROXY_GATE_BIND=0.0.0.0:25565
MCPROXY_GATE_ONLINE_MODE=true
# Enable only when a trusted L4 proxy sends HAProxy PROXY protocol headers.
# Restrict accepted senders with the proxy/LB CIDRs below; otherwise clients
# could spoof their source address and bypass per-IP Gate quotas.
# MCPROXY_GATE_PROXY_PROTOCOL=true
# MCPROXY_GATE_PROXY_PROTOCOL_TRUSTED_PROXIES=10.0.0.0/8,192.0.2.10
# MCPROXY_GATE_PROXY_PROTOCOL_BACKEND=false
# Optional application-level concurrent login limit per source IP (0 disables).
# Applies to modern clients with a UUID during login; older clients are not limited.
# Redis shares reservations across Gate replicas; without Redis it is per process.
# MCPROXY_GATE_MAX_CONCURRENT_LOGINS_PER_IP=8
# Global fallback for backend player information forwarding: none | legacy | velocity.
# BungeeGuard is intentionally not valid here; select it per server.
# Prefer the per-server forwarding_mode field for mixed backend deployments.
# Paper/Spigot legacy forwarding requires online-mode=false and bungeecord=true on the backend.
MCPROXY_GATE_FORWARDING_MODE=legacy
# Set the matching secret when using velocity forwarding. BungeeGuard tokens
# are generated per backend and exposed as bungeeguard_allowed_token.
# MCPROXY_GATE_VELOCITY_SECRET=replace-with-the-backend-secret
MCPROXY_PING_CACHE_TTL_SEC=300
MCPROXY_PING_FALLBACK_MOTD="mcproxy online"
MCPROXY_PING_OFFLINE_MOTD="server unavailable"
# MCPROXY_PING_FALLBACK_FAVICON=data:image/png;base64,...

# Admin API token (required for /api/v1/*)
# MCPROXY_ADMIN_TOKEN=change-me
# Optional maximum queued admin API requests (default: 32).
# MCPROXY_ADMIN_THROTTLE=32
# Optional shared secret with the separate admin panel. When set on both sides,
# the panel signs X-Admin-Actor so audit logs cannot be relabeled by callers
# that only possess the mcproxy API token.
# MCPROXY_ADMIN_ACTOR_SECRET=generate-a-separate-random-secret
# Exact browser origins for a separately hosted SvelteKit admin panel (optional).
# MCPROXY_ADMIN_ALLOWED_ORIGINS=https://admin.example.com
# Only enable when a trusted reverse proxy rewrites these headers. Default: false.
# MCPROXY_TRUST_PROXY_HEADERS=true
# MCPROXY_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.0.2.10/32

# Database configuration
# Options: sqlite | postgres
MCPROXY_DB_DRIVER=sqlite
# SQLite file path (used when MCPROXY_DB_DRIVER=sqlite)
MCPROXY_SQLITE_PATH="data/mcproxy.db?_pragma=foreign_keys(1)"
# PostgreSQL DSN example (used when MCPROXY_DB_DRIVER=postgres)
# MCPROXY_POSTGRES_DSN=postgres://user:password@localhost:5432/mcproxy?sslmode=disable
# Set true in production preflight to require explicit PostgreSQL TLS.
# MCPROXY_REQUIRE_POSTGRES_TLS=true
# Compose PostgreSQL transport mode: disable (local default), require, or verify-full.
# POSTGRES_SSLMODE=verify-full

# Redis for distributed counters/cache invalidation (optional)
# MCPROXY_REDIS_ADDR=127.0.0.1:6379
# MCPROXY_REDIS_PASSWORD=replace-with-redis-password
# MCPROXY_REDIS_TLS=false
# Set true in production preflight when Redis crosses a host/trust boundary.
# MCPROXY_REQUIRE_REDIS_TLS=true
# MCPROXY_REDIS_CHANNEL=mcproxy:events
# Set true to deny evaluations when Redis counters fail instead of using local
# fallback. This is stricter but can reject connections during Redis outages.
# MCPROXY_REDIS_FAIL_CLOSED=false

# GeoLite2-City.mmdb path (optional)
# MCPROXY_GEOIP_PATH=data/GeoLite2-City.mmdb
# Optional MaxMind GeoLite2-ASN.mmdb for asn-allow/asn-deny rules.
# MCPROXY_GEOIP_ASN_PATH=data/GeoLite2-ASN.mmdb

# Loki logging (optional)
# MCPROXY_LOKI_HOST=http://127.0.0.1:3100/loki/api/v1/push
MCPROXY_LOG_IDENTIFY=local
